# PostgreSQL 연결 설정
# 이 파일을 복사해 .env 로 저장하고 실제 값을 입력하세요.
# backend/ 폴더에서 실행하면 @nestjs/config가 자동으로 읽습니다.

DB_USER=postgres
DB_HOST=localhost
DB_NAME=keymanager
DB_PASSWORD=your_password_here
DB_PORT=5432

# API 서버 포트
PORT=5000

# 브라우저 요청을 허용할 프론트 주소 (여러 개면 쉼표로 구분)
CORS_ORIGIN=http://localhost:3000

# e2e 시험(npm run test:e2e)은 위 접속 정보를 쓰되 DB 이름을 keymanager_test로 바꿔서 실행합니다.
# keymanager_test가 없으면 시험 시작 때 만들고, 시험마다 그 안의 license_keys 테이블을 비웁니다.
